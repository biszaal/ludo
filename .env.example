# ---------------------------------------------------------------------------
# SERVER-ONLY SECRETS (root) — used by Supabase Edge Functions / CLI.
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
# The service-role key bypasses Row-Level Security: Edge-Function-only.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_PASSWORD=xxxxxxxxxxxxxxxx

# Client-safe values live in apps/mobile/.env (EXPO_PUBLIC_* prefix), e.g.:
#   EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
