{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "ios": { "simulator": true, "image": "macos-tahoe-26.4-xcode-26.4" },
      "android": { "buildType": "apk" }
    },
    "preview-audiodebug": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_SOUND_DEBUG": "1", "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "ios": { "simulator": true, "image": "macos-tahoe-26.4-xcode-26.4" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": { "SENTRY_DISABLE_AUTO_UPLOAD": "true" },
      "ios": { "image": "macos-tahoe-26.4-xcode-26.4" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "biszaal@icloud.com",
        "ascAppId": "6788536072"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "production"
      }
    },
    "internal": {
      "ios": {
        "appleId": "biszaal@icloud.com",
        "ascAppId": "6788536072"
      },
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    }
  }
}
