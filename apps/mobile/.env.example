# Copy to `.env` and fill in. Client-safe values only (no secrets here).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# RevenueCat public SDK keys (safe to embed in the app). Use your per-platform
# keys for release — appl_… (iOS) and goog_… (Android). A RevenueCat Test Store
# key (test_…) works for BOTH while wiring things up.
#
# These are REQUIRED for gems to be purchasable: 0027 turned gems.purchasesEnabled
# on, and the real path is client → RevenueCat → rc-webhook → gem_apply. Leaving
# them blank disables billing for the build; the gem packs then simply fail to
# buy. There is no stub fallback — gems.allowStubProvider is locked off
# server-side so a misconfigured build can never mint unpaid gems.
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxx
