# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo
# ...except the shared packages' compiled output, which the mobile app imports
# at runtime. EAS clones a clean tree (no local build), so this must be present
# for the Metro bundle to resolve @ludo/engine + @ludo/bot. The eas-build-post-
# install hook also rebuilds it, but committing keeps the build self-contained.
!packages/engine/dist/
!packages/bot/dist/

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example

# Expo / React Native
apps/mobile/.expo/
apps/mobile/web-build/
apps/mobile/ios/
apps/mobile/android/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Supabase
supabase/.branches/
supabase/.temp/
# Generated: engine copied for Deno (run `npm run build:edge`)
supabase/functions/_shared/engine/

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Test / coverage
coverage/

# OS / editor
.DS_Store
.idea/
.vscode/
.history/
*.swp

# Qodo (unused)
.qodo/
